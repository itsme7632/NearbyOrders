# Copy to .env for local device-build testing. Never commit .env.
#
# Absolute API base for Capacitor Android builds installed on a physical
# device. Must include the full path prefix (.../api/v1). Trailing slashes
# are stripped automatically.
#
# Web (browser) builds do not need this: they default to the same-origin
# relative path /api/v1 served through the Vite dev proxy.
#
# Production default: apps/mobile/.env.production is committed and sets
# VITE_API_BASE_URL=https://api.nearbyorders.com/api/v1 for every
# `vite build`. To target a staging/dev server for a local device build,
# create .env.production.local (gitignored, wins over .env.production):
#
#   VITE_API_BASE_URL=https://staging.example.com/api/v1
#
# Example:
# VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_API_BASE_URL=
