# Production API endpoint for NearbyOrders Android (Capacitor) builds.
#
# Vite loads this file automatically for `vite build` (production mode) and
# bakes VITE_API_BASE_URL into the bundle (see src/api.ts). A physical device
# has no same-origin API, so the absolute production URL is required.
#
# This file is intentionally committed: it is the production default, not a
# secret. Override locally (gitignored, highest Vite priority) with
# .env.production.local, or per-invocation via the shell environment, which
# always wins over .env files.
#
# Development (`vite dev`) never loads this file, so local web development
# through the Vite proxy is unaffected.
VITE_API_BASE_URL=https://api.nearbyorders.com/api/v1
