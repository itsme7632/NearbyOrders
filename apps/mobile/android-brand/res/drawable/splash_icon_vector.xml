<?xml version="1.0" encoding="utf-8"?>
<!-- NearbyOrders splash icon (Android 12+ SplashScreen API).
     288dp canvas, 192dp visible circle: keep all artwork within r=96 of center.
     Rendered through the animated-vector wrapper so the platform draws it at
     full size instead of upscaling a 108dp pre-render. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">
    <!-- Brand tile -->
    <path
        android:fillColor="#5C1310"
        android:pathData="M56,144 A88,88 0 1 1 232,144 A88,88 0 1 1 56,144 Z" />
    <!-- Pin mark, 2.2x about the 108dp master center, recentered to (144,144) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="2.2"
        android:scaleY="2.2"
        android:translateX="90"
        android:translateY="90">
        <path
            android:fillColor="#FBFAF8"
            android:pathData="M54,86 C52,76 51,63 44,59.3 A20,20 0 1 1 64,59.3 C57,63 56,76 54,86 Z" />
        <path
            android:fillColor="#5C1310"
            android:pathData="M46.5,38.5 H61.5 L59.3,52.8 Q59.1,54.6 57.3,54.6 H50.7 Q48.9,54.6 48.7,52.8 Z" />
        <path
            android:strokeColor="#C65324"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M49.5,38.5 C49.5,33.8 51.4,31.6 54,31.6 C56.6,31.6 58.5,33.8 58.5,38.5" />
    </group>
</vector>
