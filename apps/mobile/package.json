    "@capacitor/core": "^8.5.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "vitest": "^3.0.5"
  }
}
