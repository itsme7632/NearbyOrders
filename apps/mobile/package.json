{
  "name": "@nearbyorders/mobile",
  "private": true,
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cap:add:android": "tsc -b && vite build && cap add android",
    "cap:sync": "tsc -b && vite build && cap sync android",
    "android:brand": "node scripts/sync-android-brand.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "8.0.3",
    "@nearbyorders/shared": "workspace:*",
    "@vitejs/plugin-react": "^4.3.4",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^30.0.1",
    "vitest": "^3.0.5"
  }
}
