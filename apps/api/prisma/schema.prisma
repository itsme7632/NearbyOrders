generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BUSINESS_OWNER
  ADMIN
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(CUSTOMER)
  firstName     String?
  lastName      String?
  phone         String?
  isSuspended   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  businesses    Business[]     @relation("BusinessOwner")
  bookings      Booking[]
  orders        Order[]
  sessions      RefreshToken[]
  auditActions  AuditLog[]     @relation("AuditActor")
  notifications Notification[]
  reviews       Review[]       @relation("ReviewCustomer")

  @@index([role, isSuspended])
}

model Category {
  id         String             @id @default(uuid())
  name       String             @unique
  slug       String             @unique
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  businesses BusinessCategory[]
}

model Business {
  id            String                 @id @default(uuid())
  ownerId       String
  name          String
  slug          String                 @unique
  description   String?
  phone         String?
  email         String?
  imageUrl      String?
  isVerified    Boolean                @default(false)
  status        BusinessStatus         @default(PENDING)
  address       String
  city          String
  locality      String?
  latitude      Decimal                @db.Decimal(10, 7)
  longitude     Decimal                @db.Decimal(10, 7)
  currency      String                 @default("PKR")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  archivedAt    DateTime?
  owner         User                   @relation("BusinessOwner", fields: [ownerId], references: [id])
  categories    BusinessCategory[]
  hours         BusinessHour[]
  services      Service[]
  products      Product[]
  bookings      Booking[]
  orders        Order[]
  reviews       Review[]
  subscriptions BusinessSubscription[]

  @@index([ownerId])
  @@index([status, city])
  @@index([latitude, longitude])
}

model BusinessCategory {
  businessId String
  categoryId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([businessId, categoryId])
  @@index([categoryId])
}

model BusinessHour {
  id         String   @id @default(uuid())
  businessId String
  dayOfWeek  Int
  opensAt    String?
  closesAt   String?
  isClosed   Boolean  @default(false)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
}

model Service {
  id              String    @id @default(uuid())
  businessId      String
  name            String
  description     String?
  priceMinor      Int
  currency        String    @default("PKR")
  durationMinutes Int?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@index([businessId, isActive])
}

model Product {
  id          String      @id @default(uuid())
  businessId  String
  name        String
  description String?
  priceMinor  Int
  currency    String      @default("PKR")
  imageUrl    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       OrderItem[]

  @@index([businessId, isActive])
}

model Booking {
  id          String        @id @default(uuid())
  customerId  String
  businessId  String
  serviceId   String?
  bookingDate DateTime      @db.Date
  startAt     DateTime
  endAt       DateTime
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  customer    User          @relation(fields: [customerId], references: [id])
  business    Business      @relation(fields: [businessId], references: [id])
  service     Service?      @relation(fields: [serviceId], references: [id])
  review      Review?

  @@index([businessId, status])
  @@index([customerId, status])
  @@index([businessId, bookingDate])
}

model Order {
  id              String      @id @default(uuid())
  customerId      String
  businessId      String
  status          OrderStatus @default(PENDING)
  subtotalMinor   Int
  currency        String      @default("PKR")
  fulfillmentType String      @default("PICKUP")
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  customer        User        @relation(fields: [customerId], references: [id])
  business        Business    @relation(fields: [businessId], references: [id])
  items           OrderItem[]
  review          Review?

  @@index([businessId, status])
  @@index([customerId, status])
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  productId      String
  name           String
  unitPriceMinor Int
  quantity       Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

/// In-app notification. One row per (userId, type, entityId) event; a unique
/// index on (userId, type, entityId) makes retry-safe creation idempotent.
model Notification {
  id         String    @id @default(uuid())
  userId     String
  type       String
  title      String
  message    String
  entityType String
  entityId   String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, entityId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
}

/// A configurable commercial plan. Prices are integer minor units (paisa) —
/// never floating point. The catalog is seeded from `PLAN_CATALOG` in
/// `src/lib.ts`; re-seeding never clobbers admin-edited prices (update is a no-op).
model Plan {
  id                String                 @id @default(uuid())
  slug              String                 @unique
  name              String                 @unique
  description       String?
  monthlyPriceMinor Int
  currency          String                 @default("PKR")
  trialDays         Int                    @default(0)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  subscriptions     BusinessSubscription[]

  @@index([isActive])
}

/// The commercial relationship between a business and a plan. A business has at
/// most one live (TRIAL/ACTIVE) subscription at a time — enforced by the
/// advisory-lock + re-check pattern in the start-trial handler (same approach
/// as booking slot protection), not by a partial index. Ended rows are kept as
/// history. No payment records exist in this phase: activation with real
/// payments arrives later.
model BusinessSubscription {
  id                   String             @id @default(uuid())
  businessId           String
  planId               String
  status               SubscriptionStatus @default(TRIAL)
  trialStartAt         DateTime?
  trialEndAt           DateTime?
  currentPeriodStartAt DateTime
  currentPeriodEndAt   DateTime
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  business             Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])

  @@index([businessId, status])
  @@index([planId])
  @@index([status, currentPeriodEndAt])
}

/// A customer review backed by exactly one qualifying completed transaction.
/// Exactly one of bookingId / orderId is set — enforced in code and by the
/// two partial unique indexes below, which also block duplicate reviews for
/// the same transaction.
model Review {
  id         String   @id @default(uuid())
  businessId String
  customerId String
  bookingId  String?  @unique
  orderId    String?  @unique
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  customer   User     @relation("ReviewCustomer", fields: [customerId], references: [id])
  booking    Booking? @relation(fields: [bookingId], references: [id])
  order      Order?   @relation(fields: [orderId], references: [id])

  @@index([businessId, createdAt])
  @@index([customerId, createdAt])
}
