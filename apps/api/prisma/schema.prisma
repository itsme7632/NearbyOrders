generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BUSINESS_OWNER
  ADMIN
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

/// Server-authoritative free-trial lifecycle for a business. A trial can only
/// ever be claimed once: claiming requires ELIGIBLE, and claiming flips the
/// status to ACTIVE (then EXPIRED, or CONVERTED when the trial turns into a
/// paid subscription). PENDING_REVIEW means the business's verification
/// application is under review — the trial becomes claimable only after the
/// verification is approved.
enum TrialStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  PENDING_REVIEW
  ACTIVE
  EXPIRED
  CONVERTED
}

/// Lifecycle of a business verification application. The owner edits only in
/// DRAFT / CHANGES_REQUESTED; SUBMITTED and UNDER_REVIEW are admin-side
/// states; APPROVED flips Business.isVerified on.
enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

/// Business-level verification state (Phase 18): the trust outcome of the
/// verification application flow, denormalized on the business for cheap
/// reads. Transitions: NOT_SUBMITTED → PENDING (on submit) →
/// VERIFIED / REJECTED (on admin decision). Request-changes keeps PENDING.
enum BusinessVerificationState {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

/// Review state of one uploaded verification document.
enum VerificationDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// How a service requires money up front. NONE = pay at the business; FIXED =
/// a set advance in minor units; PERCENTAGE = a share of the service price.
/// The advance is owed to the BUSINESS — NearbyOrders never holds it.
enum ServiceAdvanceType {
  NONE
  FIXED
  PERCENTAGE
}

/// Manual payment channels a BUSINESS accepts from its customers. CASH needs
/// no account details; the digital ones are paid externally and verified by
/// the business. This is customer→business money — deliberately separate
/// from the Phase 7B `PaymentMethodType`, which is business→NearbyOrders.
enum CustomerPaymentMethodType {
  CASH
  EASYPAISA
  JAZZCASH
  BANK_TRANSFER
  OTHER
}

/// Payment state for customer→business money. Kept deliberately separate
/// from BookingStatus/OrderStatus: a booking can be CONFIRMED while its
/// advance is PENDING_VERIFICATION, and a READY order can be UNPAID (COD).
enum CustomerPaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  FAILED
}

model User {
  id                        String                       @id @default(uuid())
  email                     String                       @unique
  passwordHash              String
  role                      Role                         @default(CUSTOMER)
  firstName                 String?
  lastName                  String?
  phone                     String?
  isSuspended               Boolean                      @default(false)
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  businesses                Business[]                   @relation("BusinessOwner")
  bookings                  Booking[]
  orders                    Order[]
  sessions                  RefreshToken[]
  auditActions              AuditLog[]                   @relation("AuditActor")
  notifications             Notification[]
  pushDevices               PushDevice[]
  notificationPrefs         NotificationPreference?
  reviews                   Review[]                     @relation("ReviewCustomer")
  reviewedPayments          SubscriptionPaymentRequest[] @relation("PaymentReviewer")
  reviewedPromotionPayments PromotionPaymentRequest[]  @relation("PromotionPaymentReviewer")
  reviewedVerifications     VerificationApplication[]    @relation("VerificationReviewer")
  reviewedPromotionRequests PromotionRequest[]           @relation("PromotionReviewer")
  createdEditorialFeatures EditorialFeature[]           @relation("EditorialFeatureCreator")
  bookingPayments           BookingPayment[]             @relation("BookingPaymentCustomer")
  orderPayments             OrderPayment[]               @relation("OrderPaymentCustomer")
  verifiedBookingPays       BookingPayment[]             @relation("BookingPaymentVerifier")
  verifiedOrderPays         OrderPayment[]               @relation("OrderPaymentVerifier")
  /// Phase 17: customer-saved (favorite) businesses. Persisted server-side,
  /// unique per (customer, business) so double-tapping save is idempotent.
  savedBy                   FavoriteBusiness[]
  /// Phase 17: the customer's address book for DELIVERY orders.
  addresses                 CustomerAddress[]

  @@index([role, isSuspended])
}

model Category {
  id                       String                    @id @default(uuid())
  name                     String                    @unique
  slug                     String                    @unique
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  businesses               BusinessCategory[]
  verificationApplications VerificationApplication[]
}

model Business {
  id                      String                       @id @default(uuid())
  ownerId                 String
  name                    String
  slug                    String                       @unique
  description             String?
  phone                   String?
  email                   String?
  imageUrl                String?
  isVerified              Boolean                      @default(false)
  status                  BusinessStatus               @default(PENDING)
  address                 String
  city                    String
  locality                String?
  // Coordinates stay nullable until the owner configures a real location.
  // There is deliberately no city-centre or other invented fallback (Phase 11).
  latitude                Decimal?                     @db.Decimal(10, 7)
  longitude               Decimal?                     @db.Decimal(10, 7)
  currency                String                       @default("PKR")
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  archivedAt              DateTime?
  owner                   User                         @relation("BusinessOwner", fields: [ownerId], references: [id])
  categories              BusinessCategory[]
  hours                   BusinessHour[]
  services                Service[]
  products                Product[]
  bookings                Booking[]
  orders                  Order[]
  reviews                 Review[]
  subscriptions           BusinessSubscription[]
  paymentRequests         SubscriptionPaymentRequest[]
  promotionPaymentRequests PromotionPaymentRequest[]
  payInMethods            BusinessPaymentMethod[]
  bookingPayments         BookingPayment[]
  orderPayments           OrderPayment[]
  /// Phase 17: customers who saved this business to their favorites.
  savedBy                 FavoriteBusiness[]
  /// One verification application per business (unique); null until the
  /// owner starts one. The owner can never set isVerified directly —
  /// only the admin review flow flips it.
  verificationApplication VerificationApplication?
  /// Promotional campaigns the business asked to join (admin-reviewed).
  promotionRequests       PromotionRequest[]
  /// Admin-curated free editorial features of this business.
  editorialFeatures       EditorialFeature[]
  /// Server-authoritative trial state. Set to NOT_ELIGIBLE / not eligible on
  /// business creation; only the admin verification-approval flow grants
  /// eligibility. Trial snapshots stay on the BusinessSubscription rows.
  trialEligible           Boolean                      @default(false)
  trialStatus             TrialStatus                  @default(NOT_ELIGIBLE)
  trialAppliedAt          DateTime?
  trialStartedAt          DateTime?
  trialEndsAt             DateTime?
  /// Business-level verification outcome (Phase 18), maintained by the
  /// verification application review flow — never owner-editable.
  verificationStatus      BusinessVerificationState    @default(NOT_SUBMITTED)
  verifiedAt              DateTime?

  // Delivery / cash-on-delivery settings (Phase 7C). The fee belongs to the
  // business — NearbyOrders takes no cut and never holds the money.
  deliveryEnabled  Boolean @default(false)
  codEnabled       Boolean @default(false)
  deliveryFeeMinor Int     @default(0)

  @@index([ownerId])
  @@index([status, city])
  @@index([latitude, longitude])
}

model BusinessCategory {
  businessId String
  categoryId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([businessId, categoryId])
  @@index([categoryId])
}

model BusinessHour {
  id         String   @id @default(uuid())
  businessId String
  dayOfWeek  Int
  opensAt    String?
  closesAt   String?
  isClosed   Boolean  @default(false)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
}

model Service {
  id                 String             @id @default(uuid())
  businessId         String
  name               String
  description        String?
  priceMinor         Int
  currency           String             @default("PKR")
  durationMinutes    Int?
  isActive           Boolean            @default(true)
  // Optional advance requirement (Phase 7C). FIXED uses advanceAmountMinor;
  // PERCENTAGE uses advancePercent (0–100). The exact advance owed is always
  // recomputed server-side and snapshotted onto each booking at creation.
  advanceType        ServiceAdvanceType @default(NONE)
  advanceAmountMinor Int?
  advancePercent     Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings           Booking[]

  @@index([businessId, isActive])
}

model Product {
  id          String      @id @default(uuid())
  businessId  String
  name        String
  description String?
  priceMinor  Int
  currency    String      @default("PKR")
  imageUrl    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       OrderItem[]

  @@index([businessId, isActive])
}

model Booking {
  id                   String           @id @default(uuid())
  customerId           String
  businessId           String
  serviceId            String?
  bookingDate          DateTime         @db.Date
  startAt              DateTime
  endAt                DateTime
  status               BookingStatus    @default(PENDING)
  notes                String?
  // Payment snapshot taken at booking creation (Phase 7C). Later service
  // edits never rewrite these — the agreed amounts stay historically correct.
  // `servicePriceMinor` is null for legacy rows / no-service bookings;
  // `amountPaidMinor` accumulates VERIFIED BookingPayment amounts.
  servicePriceMinor    Int              @default(0)
  advanceRequiredMinor Int              @default(0)
  amountPaidMinor      Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  // Set (once) when the booking reaches COMPLETED; null otherwise. Owner
  // analytics/earnings derive revenue windows from this instant (Phase 16).
  completedAt          DateTime?
  customer             User             @relation(fields: [customerId], references: [id])
  business             Business         @relation(fields: [businessId], references: [id])
  service              Service?         @relation(fields: [serviceId], references: [id])
  payments             BookingPayment[]
  review               Review?

  @@index([businessId, status])
  @@index([customerId, status])
  @@index([businessId, bookingDate])
  @@index([businessId, completedAt])
}

model Order {
  id                  String                 @id @default(uuid())
  customerId          String
  businessId          String
  status              OrderStatus            @default(PENDING)
  subtotalMinor       Int
  // Delivery fee (DELIVERY only — 0 for pickup/dine-in) and the authoritative
  // order total, both computed server-side at creation. Never client-sent.
  deliveryFeeMinor    Int                    @default(0)
  totalMinor          Int                    @default(0)
  currency            String                 @default("PKR")
  fulfillmentType     String                 @default("PICKUP")
  // The manual digital pay-in channel the customer chose (null = cash on
  // delivery / cash on pickup). Payment STATE lives on OrderPayment rows.
  paymentMethodId     String?
  notes               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  // Set (once) when the order reaches COMPLETED; null otherwise. Owner
  // analytics/earnings derive revenue windows from this instant (Phase 16).
  completedAt         DateTime?
  // DELIVERY snapshot of the customer's chosen address at placement time
  // (Phase 17). Stored per-order — later address edits/corrections on the
  // customer's address book never rewrite history on placed orders.
  deliveryAddressText String?
  customer            User                   @relation(fields: [customerId], references: [id])
  business            Business               @relation(fields: [businessId], references: [id])
  paymentMethod       BusinessPaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  items               OrderItem[]
  payments            OrderPayment[]
  review              Review?

  @@index([businessId, status])
  @@index([customerId, status])
  @@index([businessId, completedAt])
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  productId      String
  name           String
  unitPriceMinor Int
  quantity       Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

/// In-app notification. One row per (userId, type, entityId) event; a unique
/// index on (userId, type, entityId) makes retry-safe creation idempotent.
model Notification {
  id         String    @id @default(uuid())
  userId     String
  type       String
  title      String
  message    String
  entityType String
  entityId   String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, entityId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

/**
 * A registered push target (Phase 13). Multiple devices per user; the unique
 * pushToken prevents duplicate registrations of the same native token.
 * Tokens are opaque provider credentials — never logged, never sent to clients.
 */
model PushDevice {
  id         String   @id @default(uuid())
  userId     String
  platform   String
  pushToken  String   @unique
  deviceId   String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

/**
 * Per-user push preferences (Phase 13). Missing row = all categories on:
 * the absence of a record must never silently disable notifications.
 */
model NotificationPreference {
  userId           String   @id
  bookings         Boolean  @default(true)
  orders           Boolean  @default(true)
  payments         Boolean  @default(true)
  reviews          Boolean  @default(true)
  businessActivity Boolean  @default(true)
  account          Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
}

/// A configurable commercial plan. Prices are integer minor units (paisa) —
/// never floating point. The catalog is seeded from `PLAN_CATALOG` in
/// `src/lib.ts`; re-seeding never clobbers admin-edited prices (update is a no-op).
model Plan {
  id                String                 @id @default(uuid())
  slug              String                 @unique
  name              String                 @unique
  description       String?
  monthlyPriceMinor Int
  currency          String                 @default("PKR")
  trialDays         Int                    @default(0)
  /// Marketing bullets shown on the plan picker (admin-editable).
  benefits          String[]               @default([])
  /// Order in the public plan list (ascending).
  displayOrder      Int                    @default(0)
  /// Highlighted as the recommended plan on the plan picker.
  isHighlighted     Boolean                @default(false)
  /// Billing cadence label (e.g. "monthly"); prices are per interval.
  billingInterval   String                 @default("monthly")
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  subscriptions     BusinessSubscription[]

  @@index([isActive])
  @@index([isActive, displayOrder])
}

/// The commercial relationship between a business and a plan. A business has at
/// most one live (TRIAL/ACTIVE) subscription at a time — enforced by the
/// advisory-lock + re-check pattern in the start-trial handler (same approach
/// as booking slot protection), not by a partial index. Ended rows are kept as
/// history. No payment records exist in this phase: activation with real
/// payments arrives later.
model BusinessSubscription {
  id                     String                       @id @default(uuid())
  businessId             String
  planId                 String
  status                 SubscriptionStatus           @default(TRIAL)
  trialStartAt           DateTime?
  trialEndAt             DateTime?
  currentPeriodStartAt   DateTime
  currentPeriodEndAt     DateTime
  cancelledAt            DateTime?
  /// Historical snapshot of the plan at subscription start: kept even if the
  /// plan is later renamed, repriced or archived, so billing history stays
  /// honest. Never backfilled from the live plan row.
  planNameSnapshot       String?
  planPriceMinorSnapshot Int?
  /// When the one-time TRIAL_ENDING_SOON notification fired (null = not yet).
  /// Guards the best-effort notification against double-send on repeated reads.
  trialEndingNotifiedAt  DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  business               Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan                   Plan                         @relation(fields: [planId], references: [id])
  paymentRequests        SubscriptionPaymentRequest[]

  @@index([businessId, status])
  @@index([planId])
  @@index([status, currentPeriodEndAt])
}

/// A customer review backed by exactly one qualifying completed transaction.
/// Exactly one of bookingId / orderId is set — enforced in code and by the
/// two partial unique indexes below, which also block duplicate reviews for
/// the same transaction.
model Review {
  id         String    @id @default(uuid())
  businessId String
  customerId String
  bookingId  String?   @unique
  orderId    String?   @unique
  rating     Int
  comment    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// Phase 15 moderation: when set, the review is hidden from every public
  /// surface (business reviews, rating summaries, search). Null = public.
  isHiddenAt DateTime?
  business   Business  @relation(fields: [businessId], references: [id])
  customer   User      @relation("ReviewCustomer", fields: [customerId], references: [id])
  booking    Booking?  @relation(fields: [bookingId], references: [id])
  order      Order?    @relation(fields: [orderId], references: [id])

  @@index([businessId, createdAt])
  @@index([customerId, createdAt])
  // NOTE: migrations realize this as a PARTIAL index (WHERE isHiddenAt IS
  // NULL) — the schema DSL cannot express that, so `prisma migrate dev`
  // regenerates a redundant plain CREATE INDEX for it on every new
  // migration. Strip that statement (as phase18's migration does) instead
  // of applying it, or the apply fails with "relation already exists".
  @@index([businessId, isHiddenAt])
}

/// Phase 17: a customer's saved (favorite) business. Server-authoritative;
/// the (customerId, businessId) pair is unique, so saving twice is idempotent.
model FavoriteBusiness {
  customerId String
  businessId String
  createdAt  DateTime @default(now())
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([customerId, businessId])
  @@index([customerId, createdAt])
}

/// Phase 17: a customer's delivery address. At most one DEFAULT per customer
/// (partial unique index); coordinates, when present, are range-validated
/// server-side before ever reaching this table.
model CustomerAddress {
  id            String   @id @default(uuid())
  customerId    String
  label         String
  recipientName String
  phone         String?
  addressText   String
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Manual subscription payments (Phase 7B)
 */
/**
 * ------------------------------------------------------------------
 */

/// Where a business can pay its NearbyOrders subscription manually
/// (Easypaisa / JazzCash / bank transfer). Admin-managed data: changing a
/// number or IBAN never requires a mobile-app release. No credentials are
/// stored here — only the public pay-in details shown to businesses.
enum PaymentMethodType {
  EASYPAISA
  JAZZCASH
  BANK_TRANSFER
  OTHER
}

/// Lifecycle of a manual payment proof. There is no self-attestation: only an
/// ADMIN review moves money-in to an active subscription.
enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A manual pay-in channel a business can use. `displayOrder` controls the
/// order in the business picker; inactive rows are hidden from businesses.
model PaymentMethod {
  id              String                       @id @default(uuid())
  name            String
  type            PaymentMethodType
  accountTitle    String
  accountNumber   String
  iban            String?
  instructions    String?
  /// Optional QR image (URL or storage reference) shown to businesses for
  /// scan-to-pay channels. Display-only; never a credential.
  qrImageUrl      String?
  isActive        Boolean                      @default(true)
  displayOrder    Int                          @default(0)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  paymentRequests SubscriptionPaymentRequest[]
  promotionPaymentRequests PromotionPaymentRequest[]

  @@index([isActive, displayOrder])
}

/// A business's manual subscription-payment proof, awaiting (or past) admin
/// verification. `subscriptionId` links to the subscription the payment
/// intends to (re)activate; it may be null when the owner pays before any
/// subscription row exists. The amount is always the server-computed plan
/// price — never a client-sent number. Approvals use the same advisory-lock
/// transaction pattern as booking slots and trial starts, so a request can
/// only ever be processed once.
model SubscriptionPaymentRequest {
  id                   String                @id @default(uuid())
  businessId           String
  subscriptionId       String?
  paymentMethodId      String
  amountMinor          Int
  currency             String                @default("PKR")
  transactionReference String
  receiptStorageKey    String
  status               PaymentRequestStatus  @default(PENDING)
  rejectionReason      String?
  /// When the business says it actually paid (owner-supplied, not future).
  /// For admin reference only — entitlement dates are server-computed.
  paidAt               DateTime?
  /// Optional owner note about the payment (max 500 chars).
  note                 String?
  submittedAt          DateTime              @default(now())
  reviewedAt           DateTime?
  reviewedByUserId     String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription         BusinessSubscription? @relation(fields: [subscriptionId], references: [id])
  paymentMethod        PaymentMethod         @relation(fields: [paymentMethodId], references: [id])
  reviewedBy           User?                 @relation("PaymentReviewer", fields: [reviewedByUserId], references: [id])

  @@index([businessId, submittedAt])
  @@index([status, submittedAt])
  @@index([transactionReference])
  @@index([subscriptionId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Customer → business payments (Phase 7C)
 */
/**
 * ------------------------------------------------------------------
 */

/// A manual pay-in channel a BUSINESS accepts from its customers (cash on
/// delivery/pickup, Easypaisa, JazzCash, bank transfer, other). Owned and
/// configured by the business owner — deliberately separate from the Phase
/// 7B `PaymentMethod`, which models business→NearbyOrders subscription
/// pay-ins. Inactive rows are hidden from customers but kept for history.
model BusinessPaymentMethod {
  id            String                    @id @default(uuid())
  businessId    String
  type          CustomerPaymentMethodType
  displayName   String
  accountTitle  String
  accountNumber String?
  iban          String?
  instructions  String?
  isActive      Boolean                   @default(true)
  displayOrder  Int                       @default(0)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  business      Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings      BookingPayment[]
  orders        Order[]
  orderPayments OrderPayment[]            @relation("OrderPaymentMethod")

  @@index([businessId, isActive, displayOrder])
}

/// A customer's booking payment (typically a service advance). One row per
/// submitted attempt; the booking's `amountPaidMinor` accumulates only VERIFIED
/// rows. Business owners verify their own business's payments — NearbyOrders
/// records state but never holds the money. Verification follows the Phase
/// 7B advisory-lock pattern so a payment can only ever be processed once.
model BookingPayment {
  id                   String                 @id @default(uuid())
  bookingId            String
  businessId           String
  customerId           String
  amountMinor          Int
  currency             String                 @default("PKR")
  paymentMethodId      String?
  status               CustomerPaymentStatus  @default(PENDING_VERIFICATION)
  transactionReference String?
  receiptStorageKey    String?
  rejectionReason      String?
  submittedAt          DateTime               @default(now())
  verifiedAt           DateTime?
  verifiedByUserId     String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  booking              Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  business             Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer             User                   @relation("BookingPaymentCustomer", fields: [customerId], references: [id])
  paymentMethod        BusinessPaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  verifiedBy           User?                  @relation("BookingPaymentVerifier", fields: [verifiedByUserId], references: [id])

  @@index([businessId, status, submittedAt])
  @@index([bookingId, submittedAt])
  @@index([customerId, createdAt])
}

/// A customer's order payment attempt (manual digital proof, or the eventual
/// cash-collection record for COD). Order totals live on the Order row;
/// summing this table's VERIFIED rows is always safe to recompute.
model OrderPayment {
  id                   String                    @id @default(uuid())
  orderId              String
  businessId           String
  customerId           String
  amountMinor          Int
  currency             String                    @default("PKR")
  method               CustomerPaymentMethodType
  paymentMethodId      String?
  status               CustomerPaymentStatus     @default(PENDING_VERIFICATION)
  transactionReference String?
  receiptStorageKey    String?
  rejectionReason      String?
  submittedAt          DateTime                  @default(now())
  verifiedAt           DateTime?
  verifiedByUserId     String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  order                Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business             Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer             User                      @relation("OrderPaymentCustomer", fields: [customerId], references: [id])
  paymentMethod        BusinessPaymentMethod?    @relation("OrderPaymentMethod", fields: [paymentMethodId], references: [id])
  verifiedBy           User?                     @relation("OrderPaymentVerifier", fields: [verifiedByUserId], references: [id])

  @@index([businessId, status, submittedAt])
  @@index([orderId, submittedAt])
  @@index([customerId, createdAt])
}

/// Opposite side of Order.paymentMethod — a convenience pointer to the
/// business pay-in channel the customer selected at checkout.

/**
 * ------------------------------------------------------------------
 */
/**
 * Business verification (Phase 18)
 */
/**
 * ------------------------------------------------------------------
 */

/// One verification application per business. The owner fills a draft,
/// uploads supporting documents, and submits; only an ADMIN review flips the
/// status (and Business.isVerified). The owner can never set isVerified
/// directly — no owner input schema carries that field.
model VerificationApplication {
  id               String                 @id @default(uuid())
  businessId       String                 @unique
  status           VerificationStatus     @default(DRAFT)
  legalName        String?
  publicName       String?
  ownerName        String?
  phone            String?
  address          String?
  city             String?
  categoryId       String?
  description      String?
  latitude         Float?
  longitude        Float?
  /// e.g. NTN/registration number or trade-license reference (free text).
  registrationInfo String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?
  /// Internal admin note — never shown to the business owner.
  adminNotes       String?
  /// Customer-visible reviewer message (required on reject/request-changes).
  reviewerMessage  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  business         Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewer         User?                  @relation("VerificationReviewer", fields: [reviewedByUserId], references: [id])
  category         Category?              @relation(fields: [categoryId], references: [id])
  documents        VerificationDocument[]

  @@index([status, submittedAt])
}

/// One uploaded supporting document (CNIC, trade license, …). Bytes live in
/// the receipt-storage abstraction under the same opaque
/// `receipts/<uuid>.<ext>` key scheme; this row only records the key.
model VerificationDocument {
  id            String                     @id @default(uuid())
  applicationId String
  docType       String
  storageKey    String
  status        VerificationDocumentStatus @default(PENDING)
  uploadedAt    DateTime                   @default(now())
  reviewedAt    DateTime?
  note          String?
  application   VerificationApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, status])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Promotions (Phase 18)
 */
/**
 * ------------------------------------------------------------------
 */

/// Lifecycle of a business's request to join a promotion. Requesting is free
/// and creates a PENDING row an admin reviews — there is no paid checkout;
/// the team contacts the business about next steps.
enum PromotionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  EXPIRED
  CANCELLED
}

/// An admin-defined promotional campaign businesses can ask to join
/// (e.g. "Ramadan Featured", "New in Town"). Paid promotions are settled
/// through manual PromotionPaymentRequest rows verified by an admin; a
/// zero-price promotion activates on application approval with no payment.
model Promotion {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  description  String?
  benefits     String[]           @default([])
  /// Optional advertised price in minor units (display only).
  priceMinor   Int?
  currency     String             @default("PKR")
  durationDays Int?
  requirements String?
  isActive     Boolean            @default(true)
  displayOrder Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  requests     PromotionRequest[]

  @@index([isActive, displayOrder])
}

model PromotionRequest {
  id               String                 @id @default(uuid())
  businessId       String
  promotionId      String
  status           PromotionRequestStatus @default(PENDING)
  note             String?
  reviewerMessage  String?
  reviewedAt       DateTime?
  reviewedByUserId String?
  /// Server-set when the promotion actually becomes ACTIVE (never at
  /// application time). Duration is measured from here.
  activatedAt      DateTime?
  /// Server-computed at activation: activatedAt + promotion.durationDays.
  expiresAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  business         Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  promotion        Promotion              @relation(fields: [promotionId], references: [id])
  reviewer         User?                  @relation("PromotionReviewer", fields: [reviewedByUserId], references: [id])
  payments         PromotionPaymentRequest[]

  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@index([status, expiresAt])
}

/// A business's manual PROMOTION-payment proof, awaiting (or past) admin
/// verification. Mirrors SubscriptionPaymentRequest but is explicitly a
/// promotion payment: it links to the PromotionRequest it pays for, and the
/// amount is always the server-computed promotion price — never a
/// client-sent number. Admin approval of THIS payment (never of the
/// application alone) is what activates a paid promotion. Uses the same
/// advisory-lock transaction pattern, so a payment can only ever be
/// processed once.
model PromotionPaymentRequest {
  id                   String               @id @default(uuid())
  promotionRequestId   String
  businessId           String
  paymentMethodId      String
  amountMinor          Int
  currency             String               @default("PKR")
  transactionReference String
  receiptStorageKey    String
  status               PaymentRequestStatus @default(PENDING)
  rejectionReason      String?
  /// When the business says it actually paid (owner-supplied, not future).
  /// For admin reference only — activation dates are server-computed.
  paidAt               DateTime?
  /// Optional owner note about the payment (max 500 chars).
  note                 String?
  submittedAt          DateTime             @default(now())
  reviewedAt           DateTime?
  reviewedByUserId     String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  promotionRequest     PromotionRequest     @relation(fields: [promotionRequestId], references: [id], onDelete: Cascade)
  business             Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  paymentMethod        PaymentMethod        @relation(fields: [paymentMethodId], references: [id])
  reviewedBy           User?                @relation("PromotionPaymentReviewer", fields: [reviewedByUserId], references: [id])

  @@index([promotionRequestId, submittedAt])
  @@index([businessId, submittedAt])
  @@index([status, submittedAt])
  @@index([transactionReference])
}

/// An admin-curated, FREE editorial feature of a business (e.g. a staff
/// pick). This is NOT a paid promotion: it has no price, no payment, and no
/// PromotionRequest — it can never activate, extend, or stand in for a paid
/// promotion. It only exists so the customer-facing "Featured" placement has
/// an editorial source distinct from paid campaigns. Visibility is
/// date-driven: a feature shows while startAt <= now < endAt.
model EditorialFeature {
  id              String   @id @default(uuid())
  businessId      String
  /// Placement kind (e.g. "staff_pick", "editors_choice"). Free text so the
  /// editorial team can name new placements without a migration.
  placementType   String
  /// Owner-visible label (e.g. "Staff pick"). Displayed as the feature's
  /// placement label; never presented as a paid promotion.
  label           String
  startAt         DateTime @default(now())
  endAt           DateTime
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy       User     @relation("EditorialFeatureCreator", fields: [createdByUserId], references: [id])

  @@index([businessId, endAt])
  @@index([endAt, startAt])
}
