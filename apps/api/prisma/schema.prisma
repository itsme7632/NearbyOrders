generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BUSINESS_OWNER
  ADMIN
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

/// How a service requires money up front. NONE = pay at the business; FIXED =
/// a set advance in minor units; PERCENTAGE = a share of the service price.
/// The advance is owed to the BUSINESS — NearbyOrders never holds it.
enum ServiceAdvanceType {
  NONE
  FIXED
  PERCENTAGE
}

/// Manual payment channels a BUSINESS accepts from its customers. CASH needs
/// no account details; the digital ones are paid externally and verified by
/// the business. This is customer→business money — deliberately separate
/// from the Phase 7B `PaymentMethodType`, which is business→NearbyOrders.
enum CustomerPaymentMethodType {
  CASH
  EASYPAISA
  JAZZCASH
  BANK_TRANSFER
  OTHER
}

/// Payment state for customer→business money. Kept deliberately separate
/// from BookingStatus/OrderStatus: a booking can be CONFIRMED while its
/// advance is PENDING_VERIFICATION, and a READY order can be UNPAID (COD).
enum CustomerPaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  FAILED
}

model User {
  id               String                       @id @default(uuid())
  email            String                       @unique
  passwordHash     String
  role             Role                         @default(CUSTOMER)
  firstName        String?
  lastName         String?
  phone            String?
  isSuspended      Boolean                      @default(false)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  businesses       Business[]                   @relation("BusinessOwner")
  bookings         Booking[]
  orders           Order[]
  sessions         RefreshToken[]
  auditActions     AuditLog[]                   @relation("AuditActor")
  notifications    Notification[]
  reviews             Review[]                     @relation("ReviewCustomer")
  reviewedPayments    SubscriptionPaymentRequest[] @relation("PaymentReviewer")
  bookingPayments     BookingPayment[]             @relation("BookingPaymentCustomer")
  orderPayments       OrderPayment[]               @relation("OrderPaymentCustomer")
  verifiedBookingPays BookingPayment[]             @relation("BookingPaymentVerifier")
  verifiedOrderPays   OrderPayment[]               @relation("OrderPaymentVerifier")

  @@index([role, isSuspended])
}

model Category {
  id         String             @id @default(uuid())
  name       String             @unique
  slug       String             @unique
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  businesses BusinessCategory[]
}

model Business {
  id              String                       @id @default(uuid())
  ownerId         String
  name            String
  slug            String                       @unique
  description     String?
  phone           String?
  email           String?
  imageUrl        String?
  isVerified      Boolean                      @default(false)
  status          BusinessStatus               @default(PENDING)
  address         String
  city            String
  locality        String?
  // Coordinates stay nullable until the owner configures a real location.
  // There is deliberately no city-centre or other invented fallback (Phase 11).
  latitude        Decimal?                     @db.Decimal(10, 7)
  longitude       Decimal?                     @db.Decimal(10, 7)
  currency        String                       @default("PKR")
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  archivedAt      DateTime?
  owner           User                         @relation("BusinessOwner", fields: [ownerId], references: [id])
  categories      BusinessCategory[]
  hours           BusinessHour[]
  services        Service[]
  products        Product[]
  bookings        Booking[]
  orders          Order[]
  reviews         Review[]
  subscriptions   BusinessSubscription[]
  paymentRequests SubscriptionPaymentRequest[]
  payInMethods    BusinessPaymentMethod[]
  bookingPayments BookingPayment[]
  orderPayments   OrderPayment[]

  // Delivery / cash-on-delivery settings (Phase 7C). The fee belongs to the
  // business — NearbyOrders takes no cut and never holds the money.
  deliveryEnabled Boolean @default(false)
  codEnabled      Boolean @default(false)
  deliveryFeeMinor Int    @default(0)

  @@index([ownerId])
  @@index([status, city])
  @@index([latitude, longitude])
}

model BusinessCategory {
  businessId String
  categoryId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([businessId, categoryId])
  @@index([categoryId])
}

model BusinessHour {
  id         String   @id @default(uuid())
  businessId String
  dayOfWeek  Int
  opensAt    String?
  closesAt   String?
  isClosed   Boolean  @default(false)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
}

model Service {
  id                String            @id @default(uuid())
  businessId        String
  name              String
  description       String?
  priceMinor        Int
  currency          String            @default("PKR")
  durationMinutes   Int?
  isActive          Boolean           @default(true)
  // Optional advance requirement (Phase 7C). FIXED uses advanceAmountMinor;
  // PERCENTAGE uses advancePercent (0–100). The exact advance owed is always
  // recomputed server-side and snapshotted onto each booking at creation.
  advanceType       ServiceAdvanceType @default(NONE)
  advanceAmountMinor Int?
  advancePercent    Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings          Booking[]

  @@index([businessId, isActive])
}

model Product {
  id          String      @id @default(uuid())
  businessId  String
  name        String
  description String?
  priceMinor  Int
  currency    String      @default("PKR")
  imageUrl    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       OrderItem[]

  @@index([businessId, isActive])
}

model Booking {
  id          String        @id @default(uuid())
  customerId  String
  businessId  String
  serviceId   String?
  bookingDate DateTime      @db.Date
  startAt     DateTime
  endAt       DateTime
  status      BookingStatus @default(PENDING)
  notes       String?
  // Payment snapshot taken at booking creation (Phase 7C). Later service
  // edits never rewrite these — the agreed amounts stay historically correct.
  // `servicePriceMinor` is null for legacy rows / no-service bookings;
  // `amountPaidMinor` accumulates VERIFIED BookingPayment amounts.
  servicePriceMinor    Int @default(0)
  advanceRequiredMinor Int @default(0)
  amountPaidMinor      Int @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  customer    User          @relation(fields: [customerId], references: [id])
  business    Business      @relation(fields: [businessId], references: [id])
  service     Service?      @relation(fields: [serviceId], references: [id])
  payments    BookingPayment[]
  review      Review?

  @@index([businessId, status])
  @@index([customerId, status])
  @@index([businessId, bookingDate])
}

model Order {
  id              String      @id @default(uuid())
  customerId      String
  businessId      String
  status          OrderStatus @default(PENDING)
  subtotalMinor   Int
  // Delivery fee (DELIVERY only — 0 for pickup/dine-in) and the authoritative
  // order total, both computed server-side at creation. Never client-sent.
  deliveryFeeMinor Int        @default(0)
  totalMinor      Int         @default(0)
  currency        String      @default("PKR")
  fulfillmentType String      @default("PICKUP")
  // The manual digital pay-in channel the customer chose (null = cash on
  // delivery / cash on pickup). Payment STATE lives on OrderPayment rows.
  paymentMethodId String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  customer        User        @relation(fields: [customerId], references: [id])
  business        Business    @relation(fields: [businessId], references: [id])
  paymentMethod   BusinessPaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  items           OrderItem[]
  payments        OrderPayment[]
  review          Review?

  @@index([businessId, status])
  @@index([customerId, status])
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  productId      String
  name           String
  unitPriceMinor Int
  quantity       Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

/// In-app notification. One row per (userId, type, entityId) event; a unique
/// index on (userId, type, entityId) makes retry-safe creation idempotent.
model Notification {
  id         String    @id @default(uuid())
  userId     String
  type       String
  title      String
  message    String
  entityType String
  entityId   String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, entityId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
}

/// A configurable commercial plan. Prices are integer minor units (paisa) —
/// never floating point. The catalog is seeded from `PLAN_CATALOG` in
/// `src/lib.ts`; re-seeding never clobbers admin-edited prices (update is a no-op).
model Plan {
  id                String                 @id @default(uuid())
  slug              String                 @unique
  name              String                 @unique
  description       String?
  monthlyPriceMinor Int
  currency          String                 @default("PKR")
  trialDays         Int                    @default(0)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  subscriptions     BusinessSubscription[]

  @@index([isActive])
}

/// The commercial relationship between a business and a plan. A business has at
/// most one live (TRIAL/ACTIVE) subscription at a time — enforced by the
/// advisory-lock + re-check pattern in the start-trial handler (same approach
/// as booking slot protection), not by a partial index. Ended rows are kept as
/// history. No payment records exist in this phase: activation with real
/// payments arrives later.
model BusinessSubscription {
  id                   String                       @id @default(uuid())
  businessId           String
  planId               String
  status               SubscriptionStatus           @default(TRIAL)
  trialStartAt         DateTime?
  trialEndAt           DateTime?
  currentPeriodStartAt DateTime
  currentPeriodEndAt   DateTime
  cancelledAt          DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  business             Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan                 Plan                         @relation(fields: [planId], references: [id])
  paymentRequests      SubscriptionPaymentRequest[]

  @@index([businessId, status])
  @@index([planId])
  @@index([status, currentPeriodEndAt])
}

/// A customer review backed by exactly one qualifying completed transaction.
/// Exactly one of bookingId / orderId is set — enforced in code and by the
/// two partial unique indexes below, which also block duplicate reviews for
/// the same transaction.
model Review {
  id         String   @id @default(uuid())
  businessId String
  customerId String
  bookingId  String?  @unique
  orderId    String?  @unique
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  customer   User     @relation("ReviewCustomer", fields: [customerId], references: [id])
  booking    Booking? @relation(fields: [bookingId], references: [id])
  order      Order?   @relation(fields: [orderId], references: [id])

  @@index([businessId, createdAt])
  @@index([customerId, createdAt])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Manual subscription payments (Phase 7B)
 */
/**
 * ------------------------------------------------------------------
 */

/// Where a business can pay its NearbyOrders subscription manually
/// (Easypaisa / JazzCash / bank transfer). Admin-managed data: changing a
/// number or IBAN never requires a mobile-app release. No credentials are
/// stored here — only the public pay-in details shown to businesses.
enum PaymentMethodType {
  EASYPAISA
  JAZZCASH
  BANK_TRANSFER
}

/// Lifecycle of a manual payment proof. There is no self-attestation: only an
/// ADMIN review moves money-in to an active subscription.
enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A manual pay-in channel a business can use. `displayOrder` controls the
/// order in the business picker; inactive rows are hidden from businesses.
model PaymentMethod {
  id              String                       @id @default(uuid())
  name            String
  type            PaymentMethodType
  accountTitle    String
  accountNumber   String
  iban            String?
  instructions    String?
  isActive        Boolean                      @default(true)
  displayOrder    Int                          @default(0)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  paymentRequests SubscriptionPaymentRequest[]

  @@index([isActive, displayOrder])
}

/// A business's manual subscription-payment proof, awaiting (or past) admin
/// verification. `subscriptionId` links to the subscription the payment
/// intends to (re)activate; it may be null when the owner pays before any
/// subscription row exists. The amount is always the server-computed plan
/// price — never a client-sent number. Approvals use the same advisory-lock
/// transaction pattern as booking slots and trial starts, so a request can
/// only ever be processed once.
model SubscriptionPaymentRequest {
  id                   String                @id @default(uuid())
  businessId           String
  subscriptionId       String?
  paymentMethodId      String
  amountMinor          Int
  currency             String                @default("PKR")
  transactionReference String
  receiptStorageKey    String
  status               PaymentRequestStatus  @default(PENDING)
  rejectionReason      String?
  submittedAt          DateTime              @default(now())
  reviewedAt           DateTime?
  reviewedByUserId     String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription         BusinessSubscription? @relation(fields: [subscriptionId], references: [id])
  paymentMethod        PaymentMethod         @relation(fields: [paymentMethodId], references: [id])
  reviewedBy           User?                 @relation("PaymentReviewer", fields: [reviewedByUserId], references: [id])

  @@index([businessId, submittedAt])
  @@index([status, submittedAt])
  @@index([transactionReference])
  @@index([subscriptionId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Customer → business payments (Phase 7C)
 */
/**
 * ------------------------------------------------------------------
 */

/// A manual pay-in channel a BUSINESS accepts from its customers (cash on
/// delivery/pickup, Easypaisa, JazzCash, bank transfer, other). Owned and
/// configured by the business owner — deliberately separate from the Phase
/// 7B `PaymentMethod`, which models business→NearbyOrders subscription
/// pay-ins. Inactive rows are hidden from customers but kept for history.
model BusinessPaymentMethod {
  id              String                     @id @default(uuid())
  businessId      String
  type            CustomerPaymentMethodType
  displayName     String
  accountTitle    String
  accountNumber   String?
  iban            String?
  instructions    String?
  isActive        Boolean                    @default(true)
  displayOrder    Int                        @default(0)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  business        Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings        BookingPayment[]
  orders          Order[]
  orderPayments   OrderPayment[]             @relation("OrderPaymentMethod")

  @@index([businessId, isActive, displayOrder])
}

/// A customer's booking payment (typically a service advance). One row per
/// submitted attempt; the booking's `amountPaidMinor` accumulates only VERIFIED
/// rows. Business owners verify their own business's payments — NearbyOrders
/// records state but never holds the money. Verification follows the Phase
/// 7B advisory-lock pattern so a payment can only ever be processed once.
model BookingPayment {
  id                   String                  @id @default(uuid())
  bookingId            String
  businessId           String
  customerId           String
  amountMinor          Int
  currency             String                  @default("PKR")
  paymentMethodId      String?
  status               CustomerPaymentStatus   @default(PENDING_VERIFICATION)
  transactionReference String?
  receiptStorageKey    String?
  rejectionReason      String?
  submittedAt          DateTime                @default(now())
  verifiedAt           DateTime?
  verifiedByUserId     String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  booking              Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  business             Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer             User                    @relation("BookingPaymentCustomer", fields: [customerId], references: [id])
  paymentMethod        BusinessPaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  verifiedBy           User?                   @relation("BookingPaymentVerifier", fields: [verifiedByUserId], references: [id])

  @@index([businessId, status, submittedAt])
  @@index([bookingId, submittedAt])
  @@index([customerId, createdAt])
}

/// A customer's order payment attempt (manual digital proof, or the eventual
/// cash-collection record for COD). Order totals live on the Order row;
/// summing this table's VERIFIED rows is always safe to recompute.
model OrderPayment {
  id                   String                @id @default(uuid())
  orderId              String
  businessId           String
  customerId           String
  amountMinor          Int
  currency             String                @default("PKR")
  method               CustomerPaymentMethodType
  paymentMethodId      String?
  status               CustomerPaymentStatus @default(PENDING_VERIFICATION)
  transactionReference String?
  receiptStorageKey    String?
  rejectionReason      String?
  submittedAt          DateTime              @default(now())
  verifiedAt           DateTime?
  verifiedByUserId     String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer             User                  @relation("OrderPaymentCustomer", fields: [customerId], references: [id])
  paymentMethod        BusinessPaymentMethod? @relation("OrderPaymentMethod", fields: [paymentMethodId], references: [id])
  verifiedBy           User?                 @relation("OrderPaymentVerifier", fields: [verifiedByUserId], references: [id])

  @@index([businessId, status, submittedAt])
  @@index([orderId, submittedAt])
  @@index([customerId, createdAt])
}

/// Opposite side of Order.paymentMethod — a convenience pointer to the
/// business pay-in channel the customer selected at checkout.
