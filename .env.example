# NearbyOrders environment configuration.
#
# Copy to .env and change every value for real deployments.
# NEVER commit real secrets to the repository.
#
# Sections: [REQUIRED IN PRODUCTION] / [OPTIONAL] / [SEED & PROVISIONING ONLY].
# Production reads from docker-compose.prod.yml, which pulls these from the
# host environment and fail-fasts when a required variable is missing.

# ── REQUIRED IN PRODUCTION ──────────────────────────────────────────────
# With NODE_ENV=production the API refuses to start unless every variable
# below is set to a real value (see resolveServerConfig in
# apps/api/src/server.ts). Development defaults are rejected.

# Postgres connection string used by the API and by `prisma migrate deploy`.
DATABASE_URL="postgresql://nearbyorders:change-me@localhost:5432/nearbyorders?schema=public"

# Password for the production Postgres superuser (the `db` service in
# docker-compose.prod.yml). DATABASE_URL must use the same password.
POSTGRES_PASSWORD="change-me"

# Signing secrets for JWT access/refresh tokens. Must be unique, random, and
# at least 32 characters. NEVER use the development defaults or the
# docker-compose placeholder ('change-me-at-least-32-characters') in
# production — the API will not start. Generate with e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret-at-least-32-characters"

# Browser / app origins allowed to call the API (comma-separated if more than one).
# In production this must be the public admin origin PLUS the Capacitor Android
# WebView origin (the native app serves from https://localhost), e.g.
#   CORS_ORIGIN="https://admin.example.com,http://localhost"
# Wildcard "*" and the localhost development default are rejected when
# NODE_ENV=production.
CORS_ORIGIN="https://admin.example.com,https://localhost,http://localhost"

# ── OPTIONAL ────────────────────────────────────────────────────────────
# Port the API listens on inside its container (default 3000).
PORT=3000

# Push notifications (Firebase Cloud Messaging). When unset, push is silently
# disabled; the API otherwise runs normally.
FCM_PROJECT_ID=""
FCM_SERVICE_ACCOUNT_B64=""

# Directory for order receipts / verification documents. The API creates it
# on first write. Production compose sets this to /var/nearbyorders/receipts
# with a persistent volume — keep the same value here for parity.
RECEIPTS_DIR=".receipts"

# Directory for business/product images (P1). The API creates it on first
# write. Production compose sets this to /var/nearbyorders/uploads with a
# persistent volume — keep the same value here for parity.
UPLOADS_DIR=".uploads"

# Rate limits (requests per 15-minute window per IP; defaults shown).
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# New business registrations are PENDING review by default. Set to "true" only
# for dev/preview convenience — never in production.
AUTO_APPROVE_BUSINESSES=

# ── BUILD-TIME (admin web) ──────────────────────────────────────────────
# API base URL baked into the admin SPA at build time. Default '/api/v1' means
# "same origin" (the production nginx reverse proxy). Set an absolute origin
# only for topologies without the same-origin proxy, e.g.
#   VITE_API_BASE_URL=https://api.example.com/api/v1
# NOTE: the mobile app bakes this into the APK at build time as well — a
# production APK must be built with the production API URL.
VITE_API_BASE_URL=/api/v1

# ── SEED & PROVISIONING ONLY (never in the production API container) ────
# Demo seed flag for scripts/seed-demo*.ts. NEVER enable in production —
# production is seeded once with seed-categories.ts + seed-plans.ts only
# (see docs/production-deploy.md).
SEED_DEMO_DATA=false

# One-shot production admin creation via
#   apps/api/scripts/create-admin.ts
# (interactive hidden prompt is preferred; these env vars are the
# non-interactive path). Values are never logged by the script.
ADMIN_EMAIL="ops@example.com"
ADMIN_PASSWORD=""
